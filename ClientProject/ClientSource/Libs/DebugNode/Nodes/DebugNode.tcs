using System;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
using System.Diagnostics;


// @types - T1, T2, T3, T4
// @args - arg1, arg2, arg3, arg4
// @argDefs - T1 arg1, T2 arg2, T3 arg3, T4 arg4
// @argInterp - {arg1}, {arg2}, {arg3}, {arg4}

namespace BaroJunk
{
  public class DebugNode<@types> : DebugNodeBase
  {
    public static string DefaultMsgFactory(@argDefs) => $"@argInterp";
    public Func<@types, string> MsgFactory { get; set; } = DefaultMsgFactory;

    private DebugEvent EventFactory(@argDefs)
    {
      return new DebugEvent()
      {
        Type = Type,
        Args = new object[] { @args },
        Msg = MsgFactory.Invoke(@args),
      };
    }

    public void Send(@argDefs)
    {
      if (GlobalGate.IsOpen && IsOpen)
      {
        Hub.Output.Raise(EventFactory(@args));
      }
    }

    public DebugNode(string type, DebugHub hub) : base(type, hub) { }
    public DebugNode(string type, DebugHub hub, Func<@types, string> msgFactory) : base(type, hub)
    {
      MsgFactory = msgFactory;
    }
  }
}